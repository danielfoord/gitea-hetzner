# secrets.local.yaml.example
#
# Copy this to secrets.local.yaml (gitignored — never commit the copy) and
# fill in real passwords there instead of editing them into gitea-values.yaml
# directly. gitea-values.yaml stays safe to commit with its CHANGE_ME
# placeholders; the real values only ever exist in this untracked overlay
# and in the cluster's Secret objects.
#
# Install/upgrade with both files, later one wins on overlap:
#   helm install gitea gitea-charts/gitea \
#     -f gitea-values.yaml -f secrets.local.yaml -n gitea --create-namespace
#
# These paths mirror gitea-values.yaml's structure exactly — only the leaf
# password values differ.

postgresql:
  global:
    postgresql:
      auth:
        password: "<real Postgres password>"

gitea:
  admin:
    password: "<real Gitea admin password>"
    email: "<real admin email>"
