# secrets.local.yaml.example
#
# Copy this to secrets.local.yaml (gitignored — never commit the copy) and
# fill in real values there. gitea-values.yaml itself declares no passwords
# at all — each secret exists in exactly one place: here, or nowhere (letting
# the chart generate one itself).
#
# Install/upgrade with both files, later one wins on overlap:
#   helm install gitea gitea-charts/gitea \
#     -f gitea-values.yaml -f secrets.local.yaml -n gitea --create-namespace

gitea:
  admin:
    # Required — the chart only bootstraps this admin user if both username
    # (set in gitea-values.yaml) and this password are present. This is the
    # one credential a human actually needs to know, so it has to go
    # somewhere explicit: here, not in the tracked values file.
    password: "<real Gitea admin password>"
    email: "<real admin email>"

# Postgres password: deliberately not set here. Left unset, the postgresql
# subchart generates a strong random one itself and stores it in the
# `gitea-postgresql` Secret (key: password) — nothing in this repo needs to
# know it by hand; the backup job and disaster-recovery steps read it
# straight from that Secret. Only uncomment this if you specifically need a
# predictable password (e.g. an external tool that can't read cluster
# Secrets):
#
# postgresql:
#   global:
#     postgresql:
#       auth:
#         password: "<real Postgres password>"
